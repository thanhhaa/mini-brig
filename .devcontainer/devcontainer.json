{
  "name": "Haskell - mini-brig",
  // Đổi từ "haskell:9.6.7" (Docker Hub, đang timeout) sang base image của Microsoft.
  // MCR được Codespaces kéo nhanh và KHÔNG bị giới hạn pull ẩn danh như Docker Hub.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [
    8080
  ],
  // Cài toolchain Haskell + build deps. Tách ra .sh để comment cho rõ.
  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "haskell.haskell"
      ]
    }
  }
}